{
  "name": "teclaler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && tsx scripts/inlineAppAssets.ts && tsx scripts/finalizeServiceWorker.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "qa": "tsx scripts/runQa.ts",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validateContent.ts",
    "audio:generate-draft": "tsx scripts/generateDraftAudio.ts",
    "audio:generate-en-gb": "tsx scripts/generateDraftAudio.ts --locale=en-GB --force",
    "audio:generate-pt-pt": "tsx scripts/generateDraftAudio.ts --locale=pt-PT --force",
    "audio:generate-pt-br": "tsx scripts/generateDraftAudio.ts --locale=pt-BR --force",
    "images:import": "tsx scripts/importWordIllustrations.ts",
    "format": "prettier --write \"index.html\" \"package.json\" \"tsconfig*.json\" \"vite.config.ts\" \"playwright*.config.ts\" \"vitest.setup.ts\" \"e2e/**/*.ts\" \"qa/**/*.ts\" \"scripts/**/*.ts\" \"src/**/*.{ts,tsx,css}\" \"public/**/*.{json,js}\" \"README.md\"",
    "preview": "vite preview --host 0.0.0.0",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  }
}
